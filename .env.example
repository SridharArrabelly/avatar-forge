# --- Required: Voice Live / Foundry ---
AZURE_VOICELIVE_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/
AGENT_NAME=AvatarAgent
AGENT_PROJECT_NAME=avatar-forge
PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project-name>
VOICELIVE_VOICE=en-US-AvaMultilingualNeural

# --- Authentication ---
# Voice Live agent-v2 sessions require Microsoft Entra ID (AAD). API key auth
# is NOT supported for the agent WebSocket path used by this app, so the
# backend always uses DefaultAzureCredential.
#
# Local host (no Docker):  run `az login` - DefaultAzureCredential picks it
#                          up via AzureCliCredential.
#
# Azure (`azd up`):        the Container App uses a user-assigned managed
#                          identity provisioned by the infra. Nothing to set
#                          here. This is the recommended path.
#
# Local Docker:            NOT recommended. The image has no az CLI, no
#                          IMDS, and SP client secrets are typically blocked
#                          by tenant app-management policy (see README
#                          "Authentication inside the container"). If your
#                          tenant DOES allow SP secrets, you can set:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Optional: skip the IMDS managed-identity probe in DefaultAzureCredential.
# Set to "true" on a developer laptop to cut startup pre-warm from ~7s to
# ~1.5s. DefaultAzureCredential normally tries ManagedIdentityCredential
# first and waits ~5s for the IMDS endpoint at 169.254.169.254 to time out
# before falling through to AzureCliCredential. Off-Azure that probe never
# succeeds, so skipping it is pure win.
# IMPORTANT: leave UNSET (or "false") in Azure-hosted environments —
# Container Apps, App Service, and AKS workload identity all need the
# managed-identity path enabled.
# AUTH_EXCLUDE_MANAGED_IDENTITY=true

# --- Foundry agent: Grounding-with-Bing-Custom-Search tool ---
# The agent's web/news tool. LEAVE BOTH VARIABLES BELOW UNSET on a greenfield deploy:
# DEPLOY_BING_GROUNDING defaults to true, so `azd up` creates the Bing account, the
# curated site allow-list and the Foundry connection, then feeds the two names back
# automatically. There is no portal step. Edit the allow-list itself in
# infra/main.bicep (bingAllowedDomains) - it is config-as-code, not an env var.
#
# To SKIP the tool (it provisions a billable resource):
#       azd env set DEPLOY_BING_GROUNDING false
# The agent then answers from your indexed documents alone - a supported end state,
# not a broken one, and you can add it later by re-running
# scripts/setup_foundry_agent.py.
#
# To POINT AT AN EXISTING CONNECTION instead, set DEPLOY_BING_GROUNDING=false and
# name it below. Naming a connection that does not exist skips the web tool with a
# warning rather than failing the deploy.
#
#
# Connection name for the Grounding-with-Bing-Custom-Search resource in your
# Foundry project. Used only by scripts/setup_foundry_agent.py at provisioning
# time; the runtime backend never talks to Bing directly.
#BING_CONNECTION_NAME=<your-bing-grounding-connection>

# Bing Custom Search configuration (instance) name — the curated allow-list of
# domains the web tool is restricted to.
#BING_CUSTOM_CONFIG_NAME=<your-bing-custom-config>

# --- AI Search (RAG over data/*.docx) ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
SEARCH_CONNECTION_NAME=<your-ai-search-connection-name>
SEARCH_INDEX_NAME=<your-search-index-name>
# Optional API key for AI Search. If unset, AI Search uses DefaultAzureCredential
# (same caveats as Voice Live above).
AZURE_SEARCH_API_KEY=

# Optional: override the internal structural names of the search index. These
# are only read by scripts/setup_aisearch_index.py and test_aisearch_query.py
# (NOT by the runtime backend or the agent). Set them only if an existing index
# was built with different names and you want the scripts to stay compatible.
# SEARCH_VECTOR_PROFILE=default-vector-profile
# SEARCH_HNSW_ALGO=default-hnsw
# SEARCH_SEMANTIC_CONFIG=default-semantic
# SEARCH_VECTORIZER=default-vectorizer

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# NOTE: Docker --env-file does NOT tolerate spaces around `=` (use KEY=VALUE,
# no surrounding spaces, no quotes). python-dotenv is more forgiving, so a
# file that works locally may silently break inside the container.
# Foundry agent model deployment name (used by scripts/setup_foundry_agent.py).
# Validated configs for voice (see prompts/routing-test-questions.md):
#   * gpt-5.4 + AGENT_REASONING_EFFORT=none      — RECOMMENDED (current production).
#                                                 Best tool-routing accuracy (30/30
#                                                 on the routing harness) and the
#                                                 cleanest synthesis on fiscal-period
#                                                 questions and share-price (cents→rand)
#                                                 conversion.
#   * gpt-5.4-mini + AGENT_REASONING_EFFORT=none — faster first token, but lower
#                                                 routing accuracy and a few synthesis
#                                                 slips; a fine cost-saving fallback.
#   * gpt-4.1-mini                               — the original non-reasoning baseline
#                                                 the ~93.5% tool-accuracy number was
#                                                 first measured on. Kept for reference.
# Set this to the deployment name you created in your Foundry project.
AGENT_MODEL=gpt-5.4

# Reasoning effort for the Foundry agent. The valid values depend on the model:
#   * gpt-4.x / gpt-4o   — leave UNSET. They reject reasoning.effort at /responses
#                          time with `unsupported_parameter` (silent avatar).
#   * gpt-5.x (gpt-5.4 / gpt-5.4-mini) — none | low | medium | high | xhigh
#   * o1 / o3 / o4-mini  — low | medium | high
# For voice latency on the gpt-5.x models the validated value is `none`. Actual
# reasoning steps (low / medium / high) add 4-5 seconds to first-token, which
# `none` keeps the synthesis-quality benefit of the gpt-5 base model without the
# per-turn reasoning latency. Note this does NOT select a prompt: there is one
# agent prompt (prompts/agent/instructions.md) — see prompts/README.md.
AGENT_REASONING_EFFORT=none

# --- Greenfield Foundry model deployment (azd `azd up` provision only) ---
# Read ONLY when azd creates a NEW Foundry model deployment (infra/main.bicep).
# The runtime backend and the agent ignore these. For a brownfield (BYO Foundry)
# deploy they are unused. IMPORTANT: if you change the model you must change the
# version to match — an invalid model/version pair fails the deployment.
#
# MODEL_NAME and MODEL_DEPLOYMENT_NAME are NOT redundant — they are two separate
# fields on the Azure resource. MODEL_NAME is WHICH model comes from the catalogue;
# MODEL_DEPLOYMENT_NAME is what you CALL it. Deploy gpt-5.4 as `chat-prod` and you
# can swap the model behind that name later without touching a caller.
#
# You do NOT need to keep AGENT_MODEL in step: on a greenfield deploy it follows
# MODEL_DEPLOYMENT_NAME automatically, because the agent must bind to the deployment
# the template just created. Set AGENT_MODEL above only for BYO Foundry.
# MODEL_NAME=gpt-5.4
# MODEL_VERSION=2026-03-05
# MODEL_DEPLOYMENT_NAME=gpt-5.4

# Retrieval breadth for the Foundry agent tools (used by
# scripts/setup_foundry_agent.py). Both default to 8 if unset — the validated
# production value: it widens the chunk/snippet budget so summary-style
# questions answer more completely, without hurting tool routing or meeting
# scoping. AI_SEARCH_TOP_K = chunks pulled from the meeting-minutes index;
# BING_COUNT = snippets from the Bing Custom Search allow-list.
AI_SEARCH_TOP_K=8
BING_COUNT=8

# Optional: how long (seconds) the backend caches the meeting catalogue it
# fetches from AI Search at session start and injects as a system message.
# Default 900 (15 min). Read only by backend/voice/catalog.py at runtime.
# MEETING_CATALOG_TTL_S=900

# Foundry embedding model deployment name (used by scripts/setup_aisearch_index.py
# and scripts/test_aisearch_query.py). After switching embedding models, run
# `RECREATE_INDEX=true uv run python scripts/setup_aisearch_index.py` ONCE to
# drop+rebuild the index — vector dimensions are immutable on existing indexes.
EMBEDDING_DEPLOYMENT=text-embedding-3-small

DEVELOPER_MODE=false

# --- UI / Session defaults (used when DEVELOPER_MODE=false) ---
# When the sidebar is hidden, the session auto-starts using these values.
# Booleans accept: true/false (also 1/0, yes/no, on/off).
# Each setting lists ALL valid options; uncomment and change to override.

# Speech Recognition model.
#   Options: azure-speech | mai-transcribe-1
#   (mai-transcribe-1.5 is LLM Speech / batch only — not on Voice Live realtime yet.)
# SR_MODEL=mai-transcribe-1

# Recognition language (ignored for MAI Transcribe models, which auto-detect).
#   Options: auto | en-US | zh-CN | de-DE | en-GB | en-IN | en-ZA | es-ES |
#            es-MX | fr-FR | hi-IN | it-IT | ja-JP | ko-KR | pt-BR
# RECOGNITION_LANGUAGE=auto

# Audio pre-processing toggles.
#   Options: true | false
# USE_NOISE_SUPPRESSION=true
# USE_ECHO_CANCELLATION=true

# Turn detection (how the server decides the user stopped talking).
#   Options: server_vad | azure_semantic_vad
# TURN_DETECTION_TYPE=azure_semantic_vad

# Silence (ms) the VAD waits after speech before ending the user's turn.
#   Lower = snappier turns; higher = more tolerant of mid-sentence pauses.
#   Options: 500 | 1000 | 1500 | 2000   (default 500)
# TURN_DETECTION_SILENCE_MS=500

# Barge-in: let the user interrupt the avatar mid-answer by speaking.
#   Controls BOTH the client (stop avatar audio on speech) and the server
#   (interrupt_response). Keep both in sync — do not enable one without the
#   other or the avatar's own echo can hijack turns.
#   Options: true | false   (default true)
# ENABLE_BARGE_IN=true

# Make the Voice Live VAD ignore filler words ("um", "uh", "yeah", …) while
# the avatar is replying, so a small noise from the user doesn't cancel the
# in-flight response. Microsoft's recommended default for barge-in robustness.
#   Options: true | false   (default true)
# REMOVE_FILLER_WORDS=true

# End-of-utterance detector.
#   Options: none | semantic_detection_v1 | semantic_detection_v1_multilingual
# EOU_DETECTION_TYPE=semantic_detection_v1

# Let the agent speak first / interject without being asked.
#   Options: true | false
# ENABLE_PROACTIVE=false

# Verbatim opening line the avatar speaks when ENABLE_PROACTIVE=true. This is
# the only place to put a client-specific persona/greeting; the backend code
# stays generic. Leave unset for a neutral default greeting.
# PROACTIVE_GREETING=Hello, I am your assistant. How can I help you today?

# --- Voice ---
# Voice category.
#   Options: standard | custom | personal
# VOICE_TYPE=standard

# Standard voice name. Override VOICELIVE_VOICE at the top of this file
# instead — both env vars feed the same UI field.
#   Common options: en-ZA-LeahNeural | en-ZA-LukeNeural |
#     en-US-AvaNeural | en-US-AndrewNeural | en-US-JennyNeural |
#     en-US-AvaMultilingualNeural | en-US-EmmaMultilingualNeural |
#     en-us-ava:DragonHDLatestNeural | en-us-andrew:DragonHDLatestNeural |
#     en-us-emma:DragonHDLatestNeural | en-us-jenny:DragonHDLatestNeural |
#     zh-CN-XiaoxiaoMultilingualNeural | zh-HK-HiuMaanNeural |
#     mt-MT-JosephNeural | alloy | ash | ballad | coral | echo | sage |
#     shimmer | verse
#   (see frontend/index.html #voiceName for the full list)

# Speech rate as a percentage of normal.
#   Range: 50 - 150 (step 5)
# VOICE_SPEED=100

# Voice temperature (DragonHD / personal voices only).
#   Range: 0.0 - 1.0
# VOICE_TEMPERATURE=0.9

# --- Avatar ---
# Show the avatar at all.
#   Options: true | false
# AVATAR_ENABLED=true

# Avatar transport.
#   Options: webrtc | websocket
# AVATAR_OUTPUT_MODE=webrtc

# Avatar flavour flags. Independent, not mutually exclusive: IS_CUSTOM_AVATAR is a
# modifier that combines with IS_PHOTO_AVATAR (see docs/configuration.md). Both
# false = standard video avatar (AVATAR_NAME).
#   Options: true | false
IS_PHOTO_AVATAR=true
IS_CUSTOM_AVATAR=false

# Standard avatar character (used when IS_PHOTO_AVATAR=false and IS_CUSTOM_AVATAR=false).
# These are the full-body standard avatars (real-time supported). Rowan/Celine/Nia/Malik
# have no style (use the bare name). Jeff was retired (Dec 2026) and Lisa's graceful/
# technical styles aren't supported on the real-time API, so they're not listed here.
#   Options: Celine | Harry-business | Harry-casual | Harry-youthful |
#     Lisa-casual-sitting | Lori-casual | Lori-graceful | Lori-formal |
#     Malik | Max-business | Max-casual | Max-formal |
#     Meg-business | Meg-casual | Meg-formal | Nia | Rowan
# AVATAR_NAME=Lisa-casual-sitting

# Custom avatar character name (used when IS_CUSTOM_AVATAR=true). Free-text;
# must match a custom avatar provisioned in your Speech resource.
CUSTOM_AVATAR_NAME=

# Assistant persona / display name (e.g. "Nuru"). The branding knob: it sets the
# bold name on the avatar stage, the name the assistant CALLS ITSELF ("I'm Nuru"),
# the Teams bot name, the meeting-roster name, the wake phrase and the default
# --name when building the Teams package. It is a purely cosmetic label and does
# NOT select the avatar model (see AVATAR_NAME / CUSTOM_AVATAR_NAME /
# PHOTO_AVATAR_NAME below) — so you can run the "Lisa" avatar but display "Nuru".
# UNSET: every surface falls back to the friendly name of the ACTIVE avatar model
# ("Simone"; "Lisa-casual-sitting" -> "Lisa"), so the name on screen and the name
# she answers to always match. Set this only when you want a different name.
# AVATAR_DISPLAY_NAME=Nuru

# Photo-realistic avatar character (used when IS_PHOTO_AVATAR=true).
#   Options: Adrian | Amara | Amira | Anika | Bianca | Camila | Carlos |
#     Clara | Darius | Diego | Elise | Farhan | Faris | Gabrielle |
#     Hyejin | Imran | Isabella | Layla | Ling | Liwei | Marcus |
#     Matteo | Rahul | Rana | Ren | Riya | Sakura | Simone | Zayd | Zoe
PHOTO_AVATAR_NAME=Simone

# Optional background image URL behind the avatar. Leave empty for none.
# AVATAR_BACKGROUND_IMAGE_URL=

# Identity tagline shown under the avatar's name (top-left of the stage), e.g.
# the assistant's role. Leave empty to show only the name. Defaults to the
# company-agnostic "Your Digital Assistant"; set this for branded deployments
# (e.g. "Your MTN Digital Assistant").
# AVATAR_TAGLINE=Your Digital Assistant

# ============================================================================
# Avatar UX (live captions, speaking-state colour shift, suggested prompts)
# Additive UI features. Captions are OFF by default; suggested prompts are ON.
# ============================================================================

# Live captions: render a subtitle line under the avatar showing what it is
# saying (and, optionally, the user's last utterance). Reuses the existing
# transcript stream — no extra model calls. Default: false. Set to true to show.
# ENABLE_CAPTIONS=false

# Also show the user's last spoken utterance in the caption band (briefly,
# until the avatar starts answering). Only applies when ENABLE_CAPTIONS=true.
# Default: false.
# CAPTIONS_SHOW_USER=false

# Suggested prompts + onboarding hint shown on first load (before the first
# user turn). Default: true. Set to false to hide the hint and example chips.
# ENABLE_SUGGESTED_PROMPTS=true

# One-line onboarding hint shown above the example chips. By default it is
# derived in the frontend and is modality-aware: "Tap the mic or type to ask me
# anything" when the on-stage composer is actually shown, otherwise "Tap the mic
# to ask me anything" (e.g. inside Teams, where the composer is always hidden).
# Set explicitly to override on every surface.
# ONBOARDING_HINT=Tap the mic or type to ask me anything

# Pipe-separated list of tappable example questions (2-3 recommended). Tapping
# a chip sends that question through the normal text path.
# SUGGESTED_PROMPTS=What can you help me with?|Tell me about your services|How do I get started?

# Text input composer (normal mode): show a "Type a message…" pill on the
# avatar stage so users can type instead of (or alongside) using the mic.
# Reuses the existing text path; voice stays primary. The field stays disabled
# until the session connects.
#
# HOST-AWARE: the composer is shown on the standalone WEB app (default: true)
# and is ALWAYS hidden inside the Microsoft Teams client — the bot chat tab has
# Teams' native compose box, and the avatar tab is voice-first (type via the
# chat tab, or in a call via the meeting chat with an @mention). This variable
# is an optional WEB-ONLY override; set it to false to hide the composer on the
# web app too. It can never force the composer on inside Teams.
# Developer mode is unaffected — it always has its own text input.
# ENABLE_TEXT_INPUT=true

# Stop-speaking button (normal mode): show a small Stop control next to the mic
# on the avatar stage while the avatar is talking, so users can cut her off
# mid-answer (handy in noisy rooms or when typing). Reuses the existing barge-in
# interrupt path; voice barge-in still works regardless. Default: true. Set to
# false to hide the button. Teams bot chat is text-only and unaffected.
# ENABLE_STOP_BUTTON=true


# ===================================================================
# --- Teams app package identity (channel B, issue #28) ---
# ===================================================================
# Read by teams/build_package.py when it renders the manifest. Neither is
# needed to run the backend — they only shape the sideloadable package.
#
# TEAMS_APP_ID: the Teams app (manifest) id. Keep it stable across rebuilds so
# Teams treats a new package as an upgrade rather than a second app.
# TEAMS_APP_ID=<teams-app-id>
#
# TEAMS_BOT_ID: Azure Bot / Entra app GUID for the in-call media bot. Leave it
# unset for the tab-only package (the default): build_package.py drops the
# whole `bots` entry when there is no id, so the Tab never depends on a bot.
# Falls back to MEETING_BOT_APP_ID. Pair it with --enable-calling for the in-call
# media bot.
# TEAMS_BOT_ID=<bot-app-client-id>


# ===================================================================
# --- Teams in-call media participant (channel C, issue #27) ---
# ===================================================================
# Channel C is OFF unless you enable one of its two legs, so leaving these unset
# keeps the app behaving exactly as the web + tab channels do. Every ACS endpoint
# returns 503 when disabled. Enable it with MEETING_BOT_ENABLED (media bot) or by
# configuring ACS (ACS_ENDPOINT / ACS_CONNECTION_STRING, browser joiner) — either
# one is enough.
#
# The avatar joins a Teams MEETING as a speaking participant with a lip-synced
# camera tile: meeting audio -> Voice Live -> Foundry agent -> spoken answer back
# into the call. There are TWO legs, and they share this Voice Live pipeline:
#
#   1. MEDIA BOT (the real one) — a .NET service on a Windows VM using the Graph
#      Real-Time Media SDK. It hears EVERYONE in the meeting. Enabled with
#      MEETING_BOT_ENABLED below; the VM comes from the "in-call" azd profile.
#      It needs NO ACS resource — the bot connects straight to /ws/acs/audio.
#   2. BROWSER JOINER (the fallback) — /acs-join.html loads the ACS Calling Web
#      SDK from a CDN and joins as an anonymous interop guest, governed by the
#      meeting LOBBY so it needs no Teams admin. It only hears the OPERATOR'S
#      OWN MIC, so it can answer you but not the room. It needs the ACS_* vars.
#
# Never point both at the same meeting — they would hear each other and feed back.
# Runbook for both: docs/testing-meetings.md
#
# Provisioned additively by infra when ENABLE_ACS=true (see infra/main.parameters.json);
# the Container App then receives ACS_ENDPOINT automatically. Auth uses the same
# DefaultAzureCredential / managed-identity path as the rest of the app when only
# ACS_ENDPOINT is set (the app identity needs a role on the ACS resource); or set
# ACS_CONNECTION_STRING for the simplest local/dev path.
#
# ACS endpoint (https://<acs-name>.communication.azure.com/). Empty + no connection
# string disables channel C.
# ACS_ENDPOINT=
#
# ACS connection string (preferred for local/dev; includes endpoint + access key).
# When set it takes precedence over ACS_ENDPOINT + managed identity.
# ACS_CONNECTION_STRING=
#
# Public HTTPS base URL ACS calls back with call events (CloudEvents) and hosts the
# media WebSocket. Defaults to the app's own external ingress; override only behind
# a proxy/tunnel (local dev needs a Dev Tunnel / ngrok so ACS can reach you).
# ACS_CALLBACK_BASE_URL=
#
# PCM sample rate (Hz) for the ACS<->Voice Live audio bridge. 24000 matches Voice
# Live's PCM16 so no resampling is needed; 16000 is also valid. Keep them aligned.
# ACS_AUDIO_SAMPLE_RATE=24000
#
# Wake phrase / invocation the avatar listens for before answering aloud, so it
# never talks over participants (turn-taking). Comma-separated; case-insensitive.
# DEFAULT: derived from the resolved persona name as "hey <name>,<name>"
# (lower-cased) — AVATAR_DISPLAY_NAME if set, else the active avatar model's name,
# so you say "hey Simone" to the avatar shown as Simone. Set this only to override.
# ACS_WAKE_PHRASES=
#
# Require a wake phrase before she answers (half-duplex turn-taking). Set false in a
# 1:1 test meeting to have her answer every turn.
# ACS_REQUIRE_WAKE_PHRASE=true
#
# Leave the call after this many seconds of inactivity (0 disables the idle timeout).
# ACS_IDLE_TIMEOUT_S=0
#
# Seconds after an answer during which a follow-up needs NO wake phrase, so a real
# back-and-forth doesn't require saying the name every single turn. Raised from 30s
# after live testing: questions plainly aimed at her arrived 35-40s after the previous
# answer and were met with silence, which reads as being ignored.
# ACS_FOLLOWUP_WINDOW_S=90

# --- The media bot leg (no ACS resource required) ---
# Serves the media-bot bridge at /ws/acs/audio. This alone enables channel C — the
# .NET bot on the Windows VM connects here and the Voice Live pipeline does the rest.
# MEETING_BOT_ENABLED=false

# --- The avatar's face in the meeting (both legs default to audio only) ---
# Ask Voice Live to synthesise avatar VIDEO for in-call sessions. Required before
# either leg can show a face.
# ACS_AVATAR_VIDEO_ENABLED=false
#
# Media bot leg: forward decoded avatar video so it renders a lip-synced camera tile.
# The frame geometry MUST match Bot__EnableVideo / Bot__VideoWidth / Bot__VideoHeight /
# Bot__VideoFps on the VM — the bot drops mismatched frames and shows its placeholder.
# MEETING_BOT_VIDEO_ENABLED=false
# MEETING_BOT_VIDEO_WIDTH=640
# MEETING_BOT_VIDEO_HEIGHT=360
# MEETING_BOT_VIDEO_FPS=15
#
# Browser joiner leg: decode the avatar in the browser and publish it as the ACS
# video tile. Setting this false is the safe rollback — the voice keeps working.
# BROWSER_JOIN_VIDEO_ENABLED=false

# --- Windows media host (issue #27, azd/infra only — NOT read by the server) ---
# The in-call channel also provisions a Windows VM + calling bot registration.
# Those settings live in the azd environment, not here, because the running
# server never reads them:
#
#   uv run python scripts/set_profile.py --profile in-call
#   azd env set MEETING_BOT_APP_ID <calling-bot-app-id>       # must differ from BOT_APP_ID
#   azd env set MEETING_BOT_APP_TENANT_ID <tenant-id>
#   azd env set MEETING_BOT_DNS_LABEL <globally-unique-label>
#   azd env set MEETING_BOT_ADMIN_PASSWORD "<strong-password>"
#
# Full reference: docs/configuration.md
