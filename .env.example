# Local runtime and BYO tooling configuration.
# Active values are required by the default agent workflow or select the sample
# avatar. Optional overrides stay commented. Full reference: docs/configuration.md

# --- Required: Voice Live agent mode ---
AZURE_VOICELIVE_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/
AGENT_NAME=AvatarAgent
AGENT_PROJECT_NAME=avatar-forge
PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project-name>

# Default voice. See docs/configuration.md for supported voices.
# VOICELIVE_VOICE=en-US-AvaMultilingualNeural

# Local authentication uses `az login`. Skip the managed-identity probe on a
# development laptop; never set this in Azure.
# AUTH_EXCLUDE_MANAGED_IDENTITY=true

# --- Required: AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
SEARCH_CONNECTION_NAME=<your-ai-search-connection-name>
SEARCH_INDEX_NAME=<your-search-index-name>

# Use an API key instead of DefaultAzureCredential.
# AZURE_SEARCH_API_KEY=

# Index-build settings used by scripts/setup_aisearch_index.py.
# EMBEDDING_DEPLOYMENT=text-embedding-3-small
# RECREATE_INDEX=false

# --- Foundry agent tooling ---
# Required only when creating or updating an agent against BYO Foundry.
# AGENT_MODEL=gpt-5.4

# Supported gpt-5 values: none, low, medium, high, xhigh.
# AGENT_REASONING_EFFORT=none

# Optional Grounding with Bing Custom Search connection.
# BING_CONNECTION_NAME=
# BING_CUSTOM_CONFIG_NAME=

# Maximum AI Search chunks and Bing snippets retrieved per request.
# AI_SEARCH_TOP_K=8
# BING_COUNT=8

# Meeting catalogue cache lifetime in seconds.
# MEETING_CATALOG_TTL_S=900

# --- Voice Live binding ---
# `agent` uses the Foundry agent above; `model` uses a realtime model directly.
# VOICE_BINDING=agent
# VOICELIVE_MODEL=gpt-realtime-2

# Model-mode web search. Set a key, or leave it unset and the app will try
# its Entra identity — the tool is offered only if that actually works.
# WEBIQ_API_KEY=
# WEBIQ_BASE_URL=https://api.microsoft.ai/v3
# WEBIQ_ALLOWED_DOMAINS=example.com,example.org
# WEBIQ_LANGUAGE=en
# WEBIQ_REGION=ZA

# Model-mode response limits and optional spoken tool-call acknowledgement.
# REALTIME_MAX_TOKENS=1200
# REALTIME_INTERIM_TEXTS=Let me check.,One moment.
# REALTIME_INTERIM_THRESHOLD_MS=300

# --- Runtime ---
# DEVELOPER_MODE=false
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# LOG_LEVEL=INFO

# --- Session defaults ---
# Used when DEVELOPER_MODE=false. Developer mode exposes the same settings in UI.

# Speech recognition: azure-speech or mai-transcribe-1.
# SR_MODEL=mai-transcribe-1
# RECOGNITION_LANGUAGE=auto

# Audio processing.
# USE_NOISE_SUPPRESSION=true
# USE_ECHO_CANCELLATION=true

# Turn detection: server_vad or azure_semantic_vad.
# TURN_DETECTION_TYPE=azure_semantic_vad
# TURN_DETECTION_SILENCE_MS=500
# ENABLE_BARGE_IN=true
# REMOVE_FILLER_WORDS=true

# End-of-utterance detection: none, semantic_detection_v1, or
# semantic_detection_v1_multilingual.
# EOU_DETECTION_TYPE=semantic_detection_v1

# Optional proactive greeting.
# ENABLE_PROACTIVE=false
# PROACTIVE_GREETING=Hello! How can I help you today?

# --- Voice ---
# VOICE_TYPE=standard
# VOICE_SPEED=100
# VOICE_TEMPERATURE=0.9

# --- Avatar ---
# Type: standard-video, standard-photo, custom-video, or custom-photo.
AVATAR_TYPE=standard-photo
AVATAR_MODEL=Simone

# AVATAR_ENABLED=true
# AVATAR_OUTPUT_MODE=webrtc
# AVATAR_DISPLAY_NAME=Nuru
# AVATAR_TAGLINE=Your Digital Assistant
# AVATAR_BACKGROUND_IMAGE_URL=
# ENABLE_AVATAR_SPEAKING_STYLE=false

# --- Avatar UX ---
# ENABLE_CAPTIONS=false
# CAPTIONS_SHOW_USER=false
# ENABLE_SUGGESTED_PROMPTS=true
# ONBOARDING_HINT=Tap the mic or type to ask me anything
# SUGGESTED_PROMPTS=What can you help me with?|Tell me about your services|How do I get started?
# ENABLE_TEXT_INPUT=true
# ENABLE_STOP_BUTTON=true

# --- Teams package build ---
# TEAMS_HOSTNAME=<app>.azurecontainerapps.io
# TEAMS_APP_NAME=Simone
# TEAMS_APP_FULL_NAME=Simone - Azure Voice Live Avatar
# TEAMS_APP_VERSION=1.0.0
# TEAMS_APP_ID=<teams-app-id>
# TEAMS_BOT_ID=<bot-app-client-id>
# TEAMS_ENABLE_CALLING=false
# TEAMS_ENABLE_COMPANION=false

# --- Teams in-call media ---
# Browser joiner: set either ACS_ENDPOINT or ACS_CONNECTION_STRING.
# ACS_ENDPOINT=
# ACS_CONNECTION_STRING=
# ACS_CALLBACK_BASE_URL=

# Shared audio and turn-taking settings.
# ACS_AUDIO_SAMPLE_RATE=24000
# ACS_WAKE_PHRASES=
# ACS_REQUIRE_WAKE_PHRASE=true
# ACS_FOLLOWUP_WINDOW_S=90
# ACS_IDLE_TIMEOUT_S=0

# Enable the Graph media-bot bridge; no ACS resource is required.
# MEETING_BOT_ENABLED=false

# In-call avatar video. Frame values must match the .NET bot configuration.
# ACS_AVATAR_VIDEO_ENABLED=false
# MEETING_BOT_VIDEO_ENABLED=false
# MEETING_BOT_VIDEO_WIDTH=640
# MEETING_BOT_VIDEO_HEIGHT=360
# MEETING_BOT_VIDEO_FPS=15
# BROWSER_JOIN_VIDEO_ENABLED=false

# --- Conversation audit trail (docs/audit.md) ---
# Off by default. Records every turn's question, tool results and answer.
# Enabling this records the substance of conversations — confirm retention and
# access obligations first. On a deployment use: azd env set ENABLE_AUDIT true
# ENABLE_AUDIT=false
# Sink: cosmos (production) | file (JSONL, local dev) | none (discard)
# AUDIT_SINK=cosmos
# What happens when that sink cannot be built (unset endpoint, Cosmos
# unreachable, unrecognised sink name). error = refuse to start, so a
# deployment never serves conversations it silently fails to record.
# file/none accept a degraded trail that is EPHEMERAL on Container Apps.
# AUDIT_SINK_FALLBACK=error
# Set automatically by infra when audit is enabled; only set by hand for BYO Cosmos.
# AUDIT_COSMOS_ENDPOINT=
# AUDIT_COSMOS_DATABASE=audit
# AUDIT_COSMOS_CONTAINER=turns
# Per-record TTL in days; 0 or negative keeps records forever.
# AUDIT_RETENTION_DAYS=365
# AUDIT_REDACT=true
# AUDIT_QUEUE_MAX=1000
# AUDIT_TOOL_PAYLOAD_MAX_KB=32
# Agent binding only: recover tool I/O from Foundry after the turn ends.
# AUDIT_RECONCILE_AGENT_TOOLS=true
