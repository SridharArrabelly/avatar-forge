{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location":        { "value": "${AZURE_LOCATION}" },
    "foundryLocation": { "value": "${FOUNDRY_LOCATION=}" },
    "resourceGroupName": { "value": "${AZURE_RESOURCE_GROUP_NAME}" },
    "principalId":     { "value": "${AZURE_PRINCIPAL_ID=}" },

    "foundryAccountName":     { "value": "${FOUNDRY_ACCOUNT_NAME=}" },
    "foundryResourceGroup":   { "value": "${FOUNDRY_RESOURCE_GROUP=}" },
    "foundryProjectEndpoint": { "value": "${FOUNDRY_PROJECT_ENDPOINT=}" },

    "searchServiceName":   { "value": "${SEARCH_SERVICE_NAME=}" },
    "searchResourceGroup": { "value": "${SEARCH_RESOURCE_GROUP=}" },

    "appInsightsName":          { "value": "${APPINSIGHTS_NAME=}" },
    "appInsightsResourceGroup": { "value": "${APPINSIGHTS_RESOURCE_GROUP=}" },

    "agentName":           { "value": "${AGENT_NAME=AvatarAgent}" },
    "agentProjectName":    { "value": "${AGENT_PROJECT_NAME=avatar-forge}" },
    "searchConnectionName":{ "value": "${SEARCH_CONNECTION_NAME=aisearch-connection}" },
    "searchIndexName":     { "value": "${SEARCH_INDEX_NAME=knowledge-index}" },
    "voiceLiveVoice":      { "value": "${VOICELIVE_VOICE=en-US-AvaMultilingualNeural}" },
    "bingConnectionName":  { "value": "${BING_CONNECTION_NAME=}" },
    "bingCustomConfigName":{ "value": "${BING_CUSTOM_CONFIG_NAME=}" },
    "deployBingGrounding": { "value": "${DEPLOY_BING_GROUNDING=true}" },
    "bingSkuName":         { "value": "${BING_SKU_NAME=G2}" },

    "voiceBinding":        { "value": "${VOICE_BINDING=agent}" },
    "voiceLiveModel":      { "value": "${VOICELIVE_MODEL=}" },
    "developerMode":       { "value": "${DEVELOPER_MODE=false}" },
    "webIqBaseUrl":        { "value": "${WEBIQ_BASE_URL=}" },
    "webIqAllowedDomains": { "value": "${WEBIQ_ALLOWED_DOMAINS=}" },
    "webIqApiKey":         { "value": "${WEBIQ_API_KEY=}" },

    "agentModel":             { "value": "${AGENT_MODEL=}" },
    "embeddingDeployment":    { "value": "${EMBEDDING_DEPLOYMENT=text-embedding-3-small}" },
    "avatarType":             { "value": "${AVATAR_TYPE=standard-photo}" },
    "avatarModel":            { "value": "${AVATAR_MODEL=Simone}" },
    "avatarDisplayName":      { "value": "${AVATAR_DISPLAY_NAME=}" },
    "avatarTagline":          { "value": "${AVATAR_TAGLINE=}" },
    "avatarBackgroundImageUrl": { "value": "${AVATAR_BACKGROUND_IMAGE_URL=}" },
    "enableAvatarSpeakingStyle": { "value": "${ENABLE_AVATAR_SPEAKING_STYLE=false}" },
    "srModel":             { "value": "${SR_MODEL=mai-transcribe-1}" },
    "recognitionLanguage": { "value": "${RECOGNITION_LANGUAGE=auto}" },

    "modelName":           { "value": "${MODEL_NAME=gpt-5.4}" },
    "modelVersion":        { "value": "${MODEL_VERSION=2026-03-05}" },
    "modelDeploymentName": { "value": "${MODEL_DEPLOYMENT_NAME=gpt-5.4}" },
    "modelSkuName":        { "value": "${MODEL_SKU_NAME=GlobalStandard}" },
    "modelCapacity":       { "value": "${MODEL_CAPACITY=250}" },

    "enableAcs":       { "value": "${ENABLE_ACS=false}" },
    "acsDataLocation": { "value": "${ACS_DATA_LOCATION=United States}" },
    "meetingBotEnabled":   { "value": "${MEETING_BOT_ENABLED=false}" },
    "acsAudioSampleRate":  { "value": "${ACS_AUDIO_SAMPLE_RATE=}" },
    "acsRequireWakePhrase":{ "value": "${ACS_REQUIRE_WAKE_PHRASE=}" },
    "acsAvatarVideoEnabled":{ "value": "${ACS_AVATAR_VIDEO_ENABLED=}" },
    "browserJoinVideoEnabled":{ "value": "${BROWSER_JOIN_VIDEO_ENABLED=}" },

    "enableAudit":         { "value": "${ENABLE_AUDIT=false}" },
    "auditRetentionDays":  { "value": "${AUDIT_RETENTION_DAYS=365}" },

    "deployProfile":            { "value": "${DEPLOY_PROFILE=}" },
    "deployMeetingBotHost":     { "value": "${DEPLOY_MEETING_BOT_HOST=false}" },
    "meetingBotAppId":          { "value": "${MEETING_BOT_APP_ID=}" },
    "meetingBotAppTenantId":    { "value": "${MEETING_BOT_APP_TENANT_ID=}" },
    "meetingBotDnsLabel":       { "value": "${MEETING_BOT_DNS_LABEL=}" },
    "meetingBotAdminPassword":  { "value": "${MEETING_BOT_ADMIN_PASSWORD=}" },
    "meetingBotVmSize":         { "value": "${MEETING_BOT_VM_SIZE=Standard_D2s_v5}" },
    "meetingBotIconUrl":        { "value": "${MEETING_BOT_ICON_URL=}" }
  }
}
